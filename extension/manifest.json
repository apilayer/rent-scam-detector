{
  "manifest_version": 3,
  "name": "Rental Scam Detector",
  "version": "1.0.0",
  "description": "Check the listing you are looking at. Finds where its photos appear elsewhere and whether the price and location agree.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check this rental listing",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
