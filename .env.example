# Zenserp — reverse image search powers the duplicate-listing detection.
# Get a key at https://app.zenserp.com/register
ZENSERP_API_KEY=

# Optional — milliseconds to wait on a single Zenserp search (default 60000).
# Reverse image lookups typically take ~30s.
ZENSERP_TIMEOUT_MS=

# Optional — public URL of this app, so Zenserp can fetch photos you upload
# directly. Only needed in development; in production the host header is used.
# Scheme and host only, no path: the app appends NEXT_PUBLIC_BASE_PATH itself
# when it builds URLs for Zenserp to fetch.
PUBLIC_ORIGIN=

# Serve the app under a sub-path, e.g. /devtools/rental-scam-detector. Leave
# EMPTY for local development so the app runs at the root. Next inlines this
# into the client bundle at build time, so it must be set for `npm run build`,
# not just at runtime, and changing it needs a rebuild.
NEXT_PUBLIC_BASE_PATH=

# Optional: serve public/ files (images, the extension zip) from an absolute
# URL such as a CDN, instead of a basePath-relative path. Leave unset for
# default behavior.
NEXT_PUBLIC_ASSET_BASE_URL=

# --- Canonical URL -----------------------------------------------------------
# What crawlers are told about this page. Deliberately separate from
# NEXT_PUBLIC_BASE_PATH: where Next serves the app from and what its public
# address is are different questions, and conflating them either 404s local dev
# or points the canonical at a URL nobody can reach.
# Both are optional; unset falls back to the defaults in lib/site.ts.
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_SITE_PATH=
